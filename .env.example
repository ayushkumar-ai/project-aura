# ==============================================================================
# PROJECT AURA — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# Application Environment (development, production, testing)
AURA_ENV=development
AURA_APP_NAME=AURA
AURA_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Server & HTTP API Deployment
# ------------------------------------------------------------------------------
AURA_SERVER_HOST=0.0.0.0
AURA_SERVER_PORT=8000
# Set API key for Bearer token authentication in production
AURA_SERVER_API_KEY=
AURA_API_KEY_AUTH_ENABLED=false
AURA_CORS_ALLOWED_ORIGINS=*
AURA_MAX_REQUEST_BODY_BYTES=1048576
AURA_SHUTDOWN_GRACE_PERIOD_SECONDS=10.0

# ------------------------------------------------------------------------------
# Model Providers & Routing (fake, openai, generic)
# ------------------------------------------------------------------------------
AURA_MODEL_PROVIDER=fake
AURA_MODEL_NAME=fake-model-v1
AURA_API_KEY=

# Generic / Local OpenAI-compatible endpoint
AURA_GENERIC_MODEL_ENDPOINT_URL=
AURA_GENERIC_MODEL_API_KEY=
AURA_GENERIC_MODEL_NAME=
AURA_LOCAL_MODEL_ENDPOINT_URL=
AURA_ALLOW_LOCAL_MODEL_ENDPOINTS=true
AURA_MODEL_FALLBACK_ENABLED=true
AURA_MAX_MODEL_FALLBACK_ATTEMPTS=2
AURA_MODEL_REQUEST_TIMEOUT_SECONDS=30.0
AURA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AURA_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# M51 Multi-Provider Model Gateway & Intelligent Routing
# ------------------------------------------------------------------------------
AURA_MODEL_GATEWAY_ENABLED=true
AURA_MODEL_FALLBACK_PROVIDERS=groq,openai,fake
AURA_GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AURA_GEMINI_API_KEY=
AURA_GEMINI_MODEL_NAME=gemini-2.5-flash
AURA_GROQ_ENDPOINT_URL=https://api.groq.com/openai/v1
AURA_GROQ_API_KEY=
AURA_GROQ_MODEL_NAME=llama-3.3-70b-versatile
AURA_OPENAI_ENDPOINT_URL=https://api.openai.com/v1
AURA_OPENAI_API_KEY=
AURA_OPENAI_MODEL_NAME=gpt-4o-mini
AURA_GATEWAY_RETRY_ON_RATE_LIMIT=true

# ------------------------------------------------------------------------------
# Persistent Storage Locations
# ------------------------------------------------------------------------------
AURA_CHECKPOINT_DIR=.aura_checkpoints
AURA_ARTIFACT_STORAGE_DIR=.aura_artifacts
AURA_TRACE_STORAGE_DIR=.aura_traces
AURA_SKILLS_STORAGE_DIR=.aura_skills
AURA_KNOWLEDGE_STORAGE_DIR=.aura_knowledge

# ------------------------------------------------------------------------------
# Safety & Approval Boundaries
# ------------------------------------------------------------------------------
AURA_AUTO_APPROVE_SAFE_ACTIONS=true
AURA_TOOL_DEFAULT_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# Research & Web Intelligence
# ------------------------------------------------------------------------------
AURA_SEARCH_PROVIDER=fake
AURA_SEARCH_API_KEY=
AURA_SEARCH_ENDPOINT=
AURA_FETCH_TIMEOUT=10.0
AURA_MAX_SEARCH_RESULTS=5
AURA_MAX_FETCH_SOURCES=3
AURA_MAX_DOCUMENT_CHARS=10000
AURA_BROWSER_PROVIDER=fake
AURA_BROWSER_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# Autonomous Agent & Multi-Goal Scheduling
# ------------------------------------------------------------------------------
AURA_MAX_PLAN_STEPS=20
AURA_MAX_EXECUTION_ITERATIONS=50
AURA_MAX_RETRIES_PER_STEP=2
AURA_MAX_TOTAL_EXECUTION_TIME=300.0
AURA_MAX_TOOL_CALLS=50
AURA_MAX_ACTIVE_GOALS=10
AURA_MAX_CONCURRENT_ACTIVE_GOALS=4
AURA_GLOBAL_MAX_TOOL_CALLS_PER_MINUTE=120
AURA_GLOBAL_MAX_TOKENS_PER_MINUTE=100000

# ------------------------------------------------------------------------------
# Self-Healing & Epistemic Memory
# ------------------------------------------------------------------------------
AURA_AUTO_HEAL_ON_FAILURE=true
AURA_MAX_HEALING_ATTEMPTS_PER_PHASE=3
AURA_MEMORY_DECAY_ENABLED=true
AURA_MEMORY_DEFAULT_HALF_LIFE_DAYS=30.0
